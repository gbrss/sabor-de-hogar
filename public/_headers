# Cabeceras para Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/)

# Archivos generados por Astro (imágenes, fuentes, JS): el nombre lleva un hash,
# así que se pueden guardar en caché "para siempre"; si cambian, cambia el nombre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Archivos con nombre fijo: una semana de caché
/og-image.jpg
  Cache-Control: public, max-age=604800
/logo.webp
  Cache-Control: public, max-age=604800
/favicon.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# Seguridad básica para todo el sitio
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
