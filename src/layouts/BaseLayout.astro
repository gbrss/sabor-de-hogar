---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE_CONFIG } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Sabor de Hogar | Pan de Pascua Casero en Santiago",
  description = "Descubre Sabor de Hogar, pan de Pascua casero con esencia natural preparada artesanalmente. Consulta y coordina tu pedido por WhatsApp en Santiago.",
  image = "/og-image.jpg",
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url.pathname;
// Open Graph / Twitter y JSON-LD exigen URLs absolutas
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const imageURL = abs(image);
const siteURL = abs("/");
const sameAs = Object.values(SITE_CONFIG.social).filter(Boolean);
const { ga4Id } = SITE_CONFIG.analytics;
const { products } = SITE_CONFIG.offer;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteURL}#website`,
      url: siteURL,
      name: "Sabor de Hogar",
      alternateName: ["Sabor de Hogar Pan de Pascua", "sabordehogar.cl"],
      inLanguage: "es-CL",
      publisher: { "@id": `${siteURL}#negocio` },
    },
    {
      "@type": "Bakery",
      "@id": `${siteURL}#negocio`,
      url: siteURL,
      name: "Sabor de Hogar",
      description:
        "Pan de Pascua casero con esencia natural preparada artesanalmente en Santiago de Chile.",
      image: imageURL,
      logo: abs("/logo.webp"),
      telephone: "+56950075329",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Santiago",
        addressRegion: "Región Metropolitana",
        addressCountry: "CL",
      },
      areaServed: { "@type": "City", name: "Santiago" },
      ...(sameAs.length > 0 ? { sameAs } : {}),
      paymentAccepted: "Coordinación directa por WhatsApp",
      currenciesAccepted: "CLP",
      // Con precios cargados en site.ts, Google recibe cada presentación con su precio
      makesOffer: products.length
        ? products.map((p) => ({
            "@type": "Offer",
            price: p.price,
            priceCurrency: "CLP",
            availability: "https://schema.org/PreOrder",
            itemOffered: { "@type": "Product", name: `${p.name} ${p.size}` },
          }))
        : {
            "@type": "Offer",
            itemOffered: {
              "@type": "Product",
              name: "Pan de Pascua Casero con Esencia Natural",
              description:
                "Elaborado artesanalmente con esencia natural preparada por el elaborador, frutos secos y frutas confitadas.",
            },
          },
    },
  ],
};
---

<!doctype html>
<html lang="es-CL" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {Astro.site && <link rel="canonical" href={canonicalURL} />}

    <!-- SEO Primario -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="sabor de hogar, sabordehogar.cl, pan de pascua casero, pan de pascua artesanal santiago, navidad chile, esencia natural pan de pascua" />
    <meta name="author" content="Sabor de Hogar" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Sabor de Hogar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pan de Pascua casero Sabor de Hogar sobre tabla de madera" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageURL} />

    <!-- Recursos críticos que cada página quiera precargar (p. ej. la imagen principal) -->
    <slot name="head" />

    <!--
      Fuentes propias (sin Google Fonts). Solo se precarga la del título; Inter carga en paralelo
      y mientras tanto se usa un respaldo con métricas ajustadas, así el texto no se mueve y la
      imagen principal no compite por ancho de banda.
    -->
    <Font cssVariable="--font-cormorant" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-inter" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      Medición de clics a WhatsApp. Cada clic se registra con la sección de origen
      (data-wa-source o el id de la sección). Si hay ID de GA4 en src/config/site.ts se envía
      como evento `generate_lead`; si no, queda en window.dataLayer (por si se usa Tag Manager).
      El script de Google se carga recién después de que la página terminó de cargar.
    -->
    <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      if (ga4Id) {
        window.gtag('js', new Date());
        window.gtag('config', ga4Id);
        window.addEventListener('load', function () {
          setTimeout(function () {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(ga4Id);
            document.head.appendChild(s);
          }, 1500);
        });
      }
      document.addEventListener('click', function (e) {
        var link = e.target instanceof Element ? e.target.closest('a[href*="wa.me/"]') : null;
        if (!link) return;
        var zone = link.closest('[data-wa-source]');
        var section = link.closest('section[id]');
        var params = {
          method: 'whatsapp',
          wa_source: (zone && zone.getAttribute('data-wa-source')) || (section && section.id) || 'otro',
          wa_label: (link.textContent || link.getAttribute('aria-label') || '').replace(/\s+/g, ' ').trim().slice(0, 80),
        };
        if (ga4Id) window.gtag('event', 'generate_lead', params);
        else window.dataLayer.push(Object.assign({ event: 'whatsapp_click' }, params));
      }, true);
    </script>
  </head>
  <body class="bg-[#FFF8EC] text-[#4A3028] antialiased selection:bg-[#7B2638] selection:text-[#FFF8EC] min-h-screen flex flex-col">
    <slot />
  </body>
</html>
