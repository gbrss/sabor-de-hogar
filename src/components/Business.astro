---
import { SITE_CONFIG, getWhatsAppUrl } from '../config/site';

const message = '¡Hola Sabor de Hogar! Quiero cotizar pan de Pascua como regalo de Navidad para mi empresa.';
const fallbackUrl = getWhatsAppUrl(message);

const points = [
  {
    title: 'Hecho en casa, en tandas pequeñas',
    text: 'Un regalo con sabor propio, preparado con nuestra esencia natural de especias.',
  },
  {
    title: 'Listo para regalar',
    text: 'Presentación de regalo, envuelto y listo para entregar a tu equipo o clientes.',
  },
  {
    title: 'Cotización a tu medida',
    text: 'Cuéntanos cuántos panes y para cuándo, y te enviamos el valor por WhatsApp.',
  },
];

const inputClass = 'w-full rounded-lg border border-[#C9A45C]/40 bg-white px-3.5 py-2.5 text-sm text-[#4A3028] placeholder:text-[#4A3028]/45 focus:outline-none focus:ring-2 focus:ring-[#C9A45C] focus:border-[#C9A45C]';
const labelClass = 'block text-xs font-semibold text-[#4A3028] mb-1.5';
---

<section id="empresas" data-wa-source="empresas" class="py-16 md:py-24 bg-[#FAF2E3] border-y border-[#C9A45C]/20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
    <div>
      <span class="inline-block px-3 py-1 rounded-full bg-[#FFF8EC] text-xs font-bold tracking-widest uppercase text-[#7B2638] mb-4 border border-[#C9A45C]/30">
        Empresas y pedidos por volumen
      </span>
      <h2 class="font-serif-display text-3xl sm:text-4xl lg:text-5xl text-[#4A3028] font-bold leading-tight mb-5 [text-wrap:balance]">
        Regalos de Navidad para tu <span class="text-[#7B2638] italic">equipo</span>
      </h2>
      <p class="text-base text-[#4A3028]/85 leading-relaxed mb-8 max-w-xl">
        Un detalle hecho en casa para colaboradores, clientes o proveedores. Pide tu cotización y coordinamos la entrega para la fecha que necesites.
      </p>

      <ul class="space-y-5">
        {points.map((p) => (
          <li class="flex items-start gap-3.5">
            <span class="mt-0.5 w-7 h-7 shrink-0 rounded-full bg-[#7B2638]/10 text-[#7B2638] flex items-center justify-center" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
            </span>
            <div>
              <h3 class="font-serif-display text-lg font-bold text-[#4A3028] leading-snug">{p.title}</h3>
              <p class="text-sm text-[#4A3028]/80 leading-relaxed">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <form
      id="business-form"
      data-wa-number={SITE_CONFIG.whatsappNumber}
      class="bg-white rounded-2xl p-6 sm:p-8 shadow-xl border border-[#C9A45C]/30"
      aria-labelledby="business-form-title"
    >
      <h3 id="business-form-title" class="font-serif-display text-2xl font-bold text-[#4A3028] mb-1">Pide tu cotización</h3>
      <p class="text-xs text-[#4A3028]/75 mb-6">Te respondemos por WhatsApp con el valor según cantidad y fecha.</p>

      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2 sm:col-span-1">
          <label for="biz-company" class={labelClass}>Empresa</label>
          <input id="biz-company" name="company" type="text" autocomplete="organization" placeholder="Ej: Constructora Andes" class={inputClass} />
        </div>
        <div class="col-span-2 sm:col-span-1">
          <label for="biz-qty" class={labelClass}>Cantidad aproximada</label>
          <input id="biz-qty" name="qty" type="number" inputmode="numeric" min="1" placeholder="Ej: 30" class={inputClass} />
        </div>
        <div class="col-span-2 sm:col-span-1">
          <label for="biz-date" class={labelClass}>Fecha de entrega</label>
          <input id="biz-date" name="date" type="date" class={inputClass} />
        </div>
        <div class="col-span-2 sm:col-span-1">
          <label for="biz-commune" class={labelClass}>Comuna de entrega</label>
          <input id="biz-commune" name="commune" type="text" autocomplete="address-level2" placeholder="Ej: Las Condes" class={inputClass} />
        </div>
        <div class="col-span-2">
          <label for="biz-name" class={labelClass}>Tu nombre</label>
          <input id="biz-name" name="name" type="text" autocomplete="name" placeholder="Ej: Daniela Rojas" class={inputClass} />
        </div>
      </div>

      <a
        href={fallbackUrl}
        data-wa-submit
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-lg bg-[#7B2638] text-[#FFF8EC] text-base font-semibold hover:bg-[#621E2C] shadow-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#7B2638]"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Cotizar por WhatsApp
        <span class="sr-only"> (abre WhatsApp)</span>
      </a>
    </form>
  </div>
</section>

<script>
  import { bindWhatsAppForm, field, formatDateEs } from '../lib/whatsapp-form';

  const form = document.getElementById('business-form') as HTMLFormElement | null;
  if (form) {
    bindWhatsAppForm(form, (data) => {
      const company = field(data, 'company');
      const qty = field(data, 'qty');
      const date = field(data, 'date');
      const commune = field(data, 'commune');
      const name = field(data, 'name');
      const lines = [
        `¡Hola Sabor de Hogar! Quiero cotizar pan de Pascua como regalo de Navidad${company ? ` para ${company}` : ' para mi empresa'}:`,
        qty && `• Cantidad aproximada: ${qty} panes`,
        date && `• Entrega: ${formatDateEs(date)}`,
        commune && `• Comuna: ${commune}`,
        name && `\nMi nombre es ${name}.`,
        '¿Me pueden enviar una cotización?',
      ];
      return lines.filter(Boolean).join('\n');
    });
  }
</script>
