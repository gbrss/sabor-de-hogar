---
import WhatsAppButton from './WhatsAppButton.astro';
import { SITE_CONFIG, formatCLP, formatDate, getWhatsAppUrl } from '../config/site';

const { products, deliveryZones, pickup, orderDeadline } = SITE_CONFIG.offer;
// Sin JavaScript el botón igual funciona: abre WhatsApp con el mensaje genérico de pedido
const fallbackUrl = getWhatsAppUrl(SITE_CONFIG.messages.cta);

const inputClass = 'w-full rounded-lg border border-[#C9A45C]/40 bg-white px-3.5 py-2.5 text-sm text-[#4A3028] placeholder:text-[#4A3028]/45 focus:outline-none focus:ring-2 focus:ring-[#C9A45C] focus:border-[#C9A45C]';
const labelClass = 'block text-xs font-semibold text-[#4A3028] mb-1.5';
---

<section id="contacto" data-wa-source="pedido" class="py-16 md:py-24 bg-[#214A35] text-[#FFF8EC] relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">

    <!-- Texto -->
    <div class="text-center lg:text-left">
      <div class="inline-flex items-center gap-2 text-xs font-semibold tracking-widest uppercase text-[#D6B676] mb-4">
        <span>ENCARGOS NAVIDEÑOS · SANTIAGO</span>
      </div>

      <h2 class="font-serif-display text-3xl sm:text-4xl md:text-5xl text-[#FFF8EC] font-bold leading-tight mb-6 [text-wrap:balance]">
        Esta Navidad, comparte algo especial.
      </h2>

      <p class="text-base sm:text-lg text-[#FFF8EC]/85 max-w-xl mx-auto lg:mx-0 leading-relaxed mb-8 font-normal">
        Arma tu pedido aquí y se abre WhatsApp con todo escrito: solo tienes que enviarlo y te confirmamos disponibilidad{products.length > 0 ? ' y total' : ''}.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-lg mx-auto lg:mx-0 text-left pt-6 border-t border-[#FFF8EC]/15">
        <div class="flex items-start gap-3">
          <svg class="w-4 h-4 text-[#C9A45C] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          <div>
            <span class="text-xs font-semibold text-[#FFF8EC] block">Respuesta directa</span>
            <span class="text-xs text-[#FFF8EC]/75">Atención por WhatsApp ({SITE_CONFIG.phoneDisplay})</span>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-4 h-4 text-[#C9A45C] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div>
            <span class="text-xs font-semibold text-[#FFF8EC] block">{orderDeadline ? `Encargos hasta el ${formatDate(orderDeadline)}` : 'Planificación anticipada'}</span>
            <span class="text-xs text-[#FFF8EC]/75">Reserva con tiempo para tus celebraciones navideñas</span>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <WhatsAppButton message={SITE_CONFIG.messages.cta} variant="outline" size="md" class="text-[#FFF8EC] border-[#FFF8EC]/40 hover:bg-[#FFF8EC]/10 hover:border-[#FFF8EC]">
          Prefiero escribir directo
        </WhatsAppButton>
      </div>
    </div>

    <!-- Formulario de pedido -->
    <form
      id="order-form"
      data-wa-number={SITE_CONFIG.whatsappNumber}
      class="bg-[#FFF8EC] text-[#4A3028] rounded-2xl p-6 sm:p-8 shadow-2xl border border-[#C9A45C]/30"
      aria-labelledby="order-form-title"
    >
      <h3 id="order-form-title" class="font-serif-display text-2xl font-bold text-[#4A3028] mb-1">Arma tu pedido</h3>
      <p class="text-xs text-[#4A3028]/75 mb-6">Completa lo que sepas; lo demás lo coordinamos por WhatsApp.</p>

      <div class="grid grid-cols-2 gap-4">
        <div class={products.length > 0 ? 'col-span-1' : 'col-span-2 sm:col-span-1'}>
          <label for="order-qty" class={labelClass}>¿Cuántos panes?</label>
          <input id="order-qty" name="qty" type="number" inputmode="numeric" min="1" max="200" value="1" class={inputClass} />
        </div>

        {products.length > 0 && (
          <div class="col-span-1">
            <label for="order-product" class={labelClass}>Presentación</label>
            <select id="order-product" name="product" class={inputClass}>
              {products.map((p) => (
                <option value={`${p.name} ${p.size}`}>{p.size} · {formatCLP(p.price)}</option>
              ))}
              <option value="">Todavía no sé</option>
            </select>
          </div>
        )}

        {pickup && (
          <div class="col-span-2 sm:col-span-1">
            <label for="order-delivery" class={labelClass}>Entrega</label>
            <select id="order-delivery" name="delivery" class={inputClass}>
              <option value="Despacho">Despacho</option>
              <option value="Retiro">Retiro</option>
            </select>
          </div>
        )}

        <div class={pickup ? 'col-span-2 sm:col-span-1' : 'col-span-2 sm:col-span-1'}>
          <label for="order-commune" class={labelClass}>Comuna</label>
          <input id="order-commune" name="commune" type="text" autocomplete="address-level2" placeholder="Ej: Ñuñoa" list={deliveryZones.length > 0 ? 'order-zones' : undefined} class={inputClass} />
          {deliveryZones.length > 0 && (
            <datalist id="order-zones">
              {deliveryZones.map((z) => <option value={z} />)}
            </datalist>
          )}
        </div>

        <div class="col-span-2 sm:col-span-1">
          <label for="order-date" class={labelClass}>¿Para qué fecha?</label>
          <input id="order-date" name="date" type="date" max={orderDeadline || undefined} class={inputClass} />
        </div>

        <div class="col-span-2 sm:col-span-1">
          <label for="order-name" class={labelClass}>Tu nombre</label>
          <input id="order-name" name="name" type="text" autocomplete="given-name" placeholder="Ej: Camila" class={inputClass} />
        </div>

        <label class="col-span-2 flex items-center gap-2.5 text-sm text-[#4A3028] cursor-pointer select-none">
          <input name="gift" type="checkbox" value="sí" class="w-4 h-4 rounded accent-[#7B2638]" />
          Es para regalo
        </label>
      </div>

      <a
        href={fallbackUrl}
        data-wa-submit
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-lg bg-[#214A35] text-[#FFF8EC] text-base font-semibold hover:bg-[#183928] shadow-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#214A35]"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Enviar pedido por WhatsApp
        <span class="sr-only"> (abre WhatsApp)</span>
      </a>
      <p class="text-[11px] text-[#4A3028]/70 text-center mt-3">Se abre WhatsApp con tu pedido ya escrito; solo tienes que enviarlo.</p>
    </form>
  </div>
</section>

<script>
  import { bindWhatsAppForm, field, formatDateEs } from '../lib/whatsapp-form';

  const form = document.getElementById('order-form') as HTMLFormElement | null;
  if (form) {
    bindWhatsAppForm(form, (data) => {
      const qty = Math.max(1, Number(field(data, 'qty')) || 1);
      const product = field(data, 'product');
      const delivery = field(data, 'delivery');
      const commune = field(data, 'commune');
      const date = field(data, 'date');
      const name = field(data, 'name');
      const lines = [
        '¡Hola Sabor de Hogar! Quiero encargar pan de Pascua:',
        `• Cantidad: ${qty} ${qty === 1 ? 'pan' : 'panes'}`,
        product && `• Presentación: ${product}`,
        delivery && `• Entrega: ${delivery}`,
        commune && `• Comuna: ${commune}`,
        date && `• Para el: ${formatDateEs(date)}`,
        data.get('gift') && '• Es para regalo',
        name && `\nMi nombre es ${name}.`,
        '¿Me confirman disponibilidad?',
      ];
      return lines.filter(Boolean).join('\n');
    });
  }
</script>
